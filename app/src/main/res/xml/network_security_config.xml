<?xml version="1.0" encoding="utf-8"?>
<!--
  El ESP32 responde por HTTP dentro de la red WiFi local (sin certificado),
  por eso se permite tráfico http:// además de https://.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
