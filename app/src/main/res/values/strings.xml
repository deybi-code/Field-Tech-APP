    <string name="crop_generic">Cultivo general</string>
    <string name="crop_generic_desc">Rangos amplios para cuando aún no defines un cultivo.</string>
    <string name="crop_generic_tip">Elige tu cultivo para recibir recomendaciones más precisas.</string>
    <string name="crop_asparagus">Espárrago</string>
    <string name="crop_asparagus_desc">Cultivo emblemático de la costa norte. Prefiere suelos arenosos bien drenados y temperaturas frescas.</string>
    <string name="crop_asparagus_tip">Evita encharcamientos: la corona es sensible a la pudrición. Riega ligero y frecuente durante la brotación.</string>
    <string name="crop_blueberry">Arándano</string>
    <string name="crop_blueberry_desc">Exige humedad constante y suelo ácido con buen drenaje. Sensible al calor excesivo.</string>
    <string name="crop_blueberry_tip">Mantén el suelo húmedo sin saturarlo; las raíces son superficiales y se secan rápido.</string>
    <string name="crop_avocado">Palta</string>
    <string name="crop_avocado_desc">Árbol perenne sensible al exceso de agua y a las heladas. Requiere buen drenaje.</string>
    <string name="crop_avocado_tip">Riega profundo y espaciado; el exceso de humedad favorece hongos en la raíz.</string>
    <string name="crop_grape">Uva de mesa</string>
    <string name="crop_grape_desc">Se adapta bien al clima cálido y seco de la costa. Necesita estrés hídrico controlado en maduración.</string>
    <string name="crop_grape_tip">Reduce el riego cerca de la cosecha para mejorar el azúcar y la calidad del fruto.</string>
    <string name="crop_artichoke">Alcachofa</string>
    <string name="crop_artichoke_desc">Prefiere climas frescos y suelos con buena humedad, sin encharcamientos.</string>
    <string name="crop_artichoke_tip">Evita periodos largos de sequía en la formación de capítulos.</string>
    <string name="crop_pepper">Pimiento piquillo</string>
    <string name="crop_pepper_desc">Cultivo de clima cálido con riegos frecuentes y uniformes.</string>
    <string name="crop_pepper_tip">Riega de forma regular; los cambios bruscos de humedad causan caída de flores y frutos.</string>
    <string name="crop_corn">Maíz amarillo duro</string>
    <string name="crop_corn_desc">Cultivo de alta demanda de agua, sobre todo en floración y llenado de grano.</string>
    <string name="crop_corn_tip">No dejes secar el suelo durante la floración: es la etapa más crítica.</string>
    <string name="crop_sugarcane">Caña de azúcar</string>
    <string name="crop_sugarcane_desc">Requiere temperaturas altas y mucha agua durante el crecimiento vegetativo.</string>
    <string name="crop_sugarcane_tip">Suspende el riego semanas antes de la cosecha para concentrar azúcares.</string>

