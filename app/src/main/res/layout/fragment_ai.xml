<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header estilo Gemini / ChatGPT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Huerto.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/brand_container"
                    android:text="✨ FieldTech AI · Gemini 1.5 Flash"
                    android:textColor="@color/brand"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_clear_chat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/brand"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Pill Contexto de Sensores en Vivo -->
        <TextView
            android:id="@+id/tv_sensor_context"
            style="@style/Widget.Huerto.Pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/brand_container"
            android:gravity="center"
            android:textColor="@color/on_brand_container" />

        <!-- Vista Central de Bienvenida Gemini (Mostrada si no hay mensajes) -->
        <LinearLayout
            android:id="@+id/layout_welcome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_sparkles"
                app:tint="@color/brand"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Hola, soy tu Asistente IA.\n¿En qué te puedo ayudar hoy?"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Conectado a tus sensores de huerto y análisis multimodal de fotos"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_secondary" />

            <!-- Chips de sugerencias rápidas estilo ChatGPT -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_irrigate"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="💧 ¿Necesito regar hoy?" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_pests"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="🐛 Diagnóstico de plagas" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_temp"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌡️ Estado del clima" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Lista de Mensajes del Chat -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ai_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Barra de Carga -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/brand" />

        <!-- Previsualización de Imagen Adjunta -->
        <FrameLayout
            android:id="@+id/layout_image_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_image_preview"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <ImageView
                android:id="@+id/btn_remove_image"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/status_bad"
                android:src="@drawable/ic_delete"
                app:tint="@color/white"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Barra Cápsula Flotante de Entrada estilo Gemini -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Huerto.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/outline_soft"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/btn_attach_image"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/brand"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/et_ai_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Pregunta o adjunta una foto..."
                    android:maxLines="4"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <ImageView
                    android:id="@+id/btn_voice_input"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/brand"
                    android:importantForAccessibility="no" />

                <FrameLayout
                    android:id="@+id/btn_ai_send"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_fab_ai"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_send"
                        app:tint="@android:color/white"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Subtítulo Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="88dp"
            android:text="FieldTech AI utiliza sensores IoT y visión multimodal. Puede cometer errores."
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
